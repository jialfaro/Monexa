# Copia a .env y rellena. Nunca pongas aquí claves privadas ni frases semilla.

# Modelos: pon una o varias claves. LLM_PROVIDER elige el principal (anthropic | openai | gemini | auto);
# con LLM_FALLBACK=true los demás proveedores configurados actúan de respaldo si el principal falla.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
LLM_FALLBACK=true
# Modelos del proveedor principal (vacío = por defecto: claude-opus-5/claude-sonnet-5, gpt-5/gpt-5-mini, gemini-3.8-flash/gemini-3.5-flash-lite)
WORKER_MODEL=
SCOUT_MODEL=
DAILY_LLM_BUDGET_USD=5

# Cobro: dirección PÚBLICA donde recibir USDC (la wallet la controlas tú, fuera de este proceso)
PAYTO_ADDRESS=
# eip155:84532 = Base Sepolia (pruebas, sin valor). eip155:8453 = Base (real).
X402_NETWORK=eip155:84532
# Facilitador x402. Para Base real necesitas uno que soporte mainnet (p. ej. CDP) y su cabecera Authorization.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_AUTH=
# URL pública para que los compradores lleguen a /x402/*. Opción gratuita sin cuenta:
# TUNNEL=cloudflare abre un túnel de Cloudflare al arrancar (requiere `brew install cloudflared`)
# y descubre la URL solo; PUBLIC_URL se ignora en ese caso. Fuera del túnel sólo se exponen los servicios x402.
TUNNEL=cloudflare
PUBLIC_URL=http://127.0.0.1:4173

# GitHub: token con permisos repo (fork, contenido, pull requests) para enviar PRs
GITHUB_TOKEN=
# Consultas de búsqueda separadas por coma
# GITHUB_BOUNTY_QUERIES=label:bounty state:open,label:"💎 Bounty" state:open

# Política
AUTO_SUBMIT=false          # true: el worker abre el PR sin esperar tu aprobación
AUTO_SCALE=true
MAX_AGENTS=8
MAX_DEPTH=3
MAX_CHILDREN_PER_AGENT=4
MAX_CONCURRENT_WORKERS=2
SCOUT_INTERVAL_MINUTES=30
RECONCILE_INTERVAL_MINUTES=10
MIN_OPPORTUNITY_SCORE=60
MAX_WORKER_ITERATIONS=25
# Repos que nunca se trabajan, separados por coma (además de la detección automática de granjas de bounties)
BLOCKED_REPOS=

# Fuentes extra (JSON) y sus hosts
# EXTRA_JSON_FEEDS=https://ejemplo.com/bounties.json
PORT=4173
