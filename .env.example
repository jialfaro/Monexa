# Copia a .env y rellena. Nunca pongas aquí claves privadas ni frases semilla.

# Modelos: pon una o varias claves. LLM_PROVIDER elige el principal (anthropic | openai | gemini | auto);
# con LLM_FALLBACK=true los demás proveedores configurados actúan de respaldo si el principal falla.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
LLM_FALLBACK=true
# Modelos del proveedor principal (vacío = por defecto: claude-opus-5/claude-sonnet-5, gpt-5/gpt-5-mini, gemini-3.8-flash/gemini-3.5-flash-lite)
WORKER_MODEL=
SCOUT_MODEL=
DAILY_LLM_BUDGET_USD=5

# Cobro: dirección PÚBLICA donde recibir USDC (la wallet la controlas tú, fuera de este proceso)
PAYTO_ADDRESS=
# eip155:84532 = Base Sepolia (pruebas, sin valor). eip155:8453 = Base (real).
X402_NETWORK=eip155:84532
# Facilitador x402. Para Base real necesitas uno que soporte mainnet (p. ej. CDP) y su cabecera Authorization.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_AUTH=
# URL pública para que los compradores lleguen a /x402/*. Opción gratuita sin cuenta:
# TUNNEL=cloudflare abre un túnel de Cloudflare al arrancar (requiere `brew install cloudflared`)
# y descubre la URL solo; PUBLIC_URL se ignora en ese caso. Fuera del túnel sólo se exponen los servicios x402.
TUNNEL=cloudflare
# TUNNEL=ngrok usa un dominio ESTABLE gratuito (cuenta ngrok: https://dashboard.ngrok.com → authtoken y dominio estático).
# Los directorios x402 rechazan URLs que cambian, así que es la opción recomendada en cuanto tengas cuenta.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
PUBLIC_URL=http://127.0.0.1:4173
# Gemini nivel gratuito: no factura, así que su coste se contabiliza a 0 (ponlo en false si activaste facturación)
GEMINI_FREE_TIER=true
# Bounties cuyo esfuerzo estimado por el modelo supere estas horas van a revisión en vez de a un worker
MAX_ESTIMATED_HOURS=6
# Intentos máximos de worker por issue (evita pagar varias veces la misma exploración)
MAX_ATTEMPTS_PER_OPPORTUNITY=2
# Por debajo de esta heurística el evaluador no gasta modelo
MIN_HEURISTIC_FOR_JUDGEMENT=25
# OpenAI Flex: mitad de precio a cambio de latencia variable (beta; vacío = tarifa estándar)
OPENAI_SERVICE_TIER=

# GitHub: token con permisos repo (fork, contenido, pull requests) para enviar PRs
GITHUB_TOKEN=
# Consultas de búsqueda separadas por coma
# GITHUB_BOUNTY_QUERIES=label:bounty state:open,label:"💎 Bounty" state:open

# Política
AUTO_SUBMIT=verified      # never | verified (pagador verificado + revisor aprueba) | always
AUTO_SCALE=true
MAX_AGENTS=8
MAX_DEPTH=3
MAX_CHILDREN_PER_AGENT=4
MAX_CONCURRENT_WORKERS=2
SCOUT_INTERVAL_MINUTES=30
RECONCILE_INTERVAL_MINUTES=10
MIN_OPPORTUNITY_SCORE=60
MAX_JOB_COST_USD=0.5      # tope de gasto de modelo por trabajo; al alcanzarlo se abandona
MIN_REVIEW_CONFIDENCE=80  # confianza mínima del revisor para el envío automático
MAX_WORKER_ITERATIONS=25
# Repos que nunca se trabajan, separados por coma (además de la detección automática de granjas de bounties)
BLOCKED_REPOS=

# Fuentes extra (JSON) y sus hosts
# EXTRA_JSON_FEEDS=https://ejemplo.com/bounties.json
PORT=4173

# Apartado Trader (simulado con precios reales; nunca ejecuta operaciones reales)
TRADER_ENABLED=true
TRADER_MODE=paper            # paper: sólo simula. proposal: además deja cada orden aprobada como propuesta para que TÚ la ejecutes en tu wallet
TRADER_WATCHLIST=BTC-USD,ETH-USD,SOL-USD
PAPER_START_USD=1000
TRADER_TICK_MINUTES=15
TRADER_CANDLE_SECONDS=3600
TRADER_FEE_RATE=0.006
TRADER_MAX_POSITION_PCT=0.2
TRADER_MAX_EXPOSURE_PCT=0.6
TRADER_STOP_LOSS_PCT=0.03
TRADER_TAKE_PROFIT_PCT=0.06
TRADER_DAILY_LOSS_LIMIT_PCT=0.05
TRADER_MIN_STRENGTH=0.55
TRADER_MIN_ORDER_USD=10
